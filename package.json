{
  "name": "trimemh",
  "version": "0.1.0",
  "description": "triMemh — local-first, governance-first agent memory system. Provides 93% token compression with ContentRouter + CCR + CacheAligner. Works with Claude Code, Cursor, Codex, Copilot, Aider via MCP.",
  "module": "src/cli.ts",
  "type": "module",
  "exports": {
    ".": "./src/cli.ts",
    "./sdk": "./src/sdk/index.ts",
    "./sdk/anthropic": "./src/sdk/anthropic.ts",
    "./sdk/claude-agent": "./src/sdk/claude-agent.ts",
    "./sdk/vercel": "./src/sdk/vercel.ts"
  },
  "bin": {
    "trimemh": "./src/cli.ts"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "benchmark": "bun scripts/benchmark.ts",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "ci": "biome ci .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "memory",
    "agent-memory",
    "llm-context",
    "mcp-server",
    "context-compression",
    "token-optimization",
    "claude-code",
    "cursor",
    "codex",
    "local-first",
    "governance",
    "vector-search",
    "sqlite-vec"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/justonemorenight/trimemh"
  },
  "homepage": "https://github.com/justonemorenight/trimemh#readme",
  "author": "Just One More Night",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.165",
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.197",
    "commander": "^15.0.0",
    "hono": "^4.12.23",
    "sqlite-vec": "^0.1.9",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  }
}
