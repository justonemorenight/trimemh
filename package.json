{
  "name": "trimemh",
  "version": "0.1.0",
  "description": "triMemh — local-first, governance-first agent memory system. Provides 93% token compression with ContentRouter + CCR + CacheAligner. Works with Claude Code, Cursor, Codex, Copilot, Aider via MCP.",
  "type": "module",
  "main": "./dist/sdk/index.js",
  "module": "./dist/sdk/index.js",
  "types": "./dist/types/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./sdk": {
      "types": "./dist/types/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./sdk/anthropic": {
      "types": "./dist/types/sdk/anthropic.d.ts",
      "import": "./dist/sdk/anthropic.js"
    },
    "./sdk/claude-agent": {
      "types": "./dist/types/sdk/claude-agent.d.ts",
      "import": "./dist/sdk/claude-agent.js"
    },
    "./sdk/vercel": {
      "types": "./dist/types/sdk/vercel.d.ts",
      "import": "./dist/sdk/vercel.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "trimemh": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "benchmark": "bun scripts/benchmark.ts",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/cli.ts src/sdk/index.ts src/sdk/anthropic.ts src/sdk/claude-agent.ts src/sdk/vercel.ts --outdir dist --target bun --format esm --packages external --entry-naming '[dir]/[name].[ext]'",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "ci": "biome ci .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pack:dry-run": "bun run build && npm pack --dry-run",
    "prepublishOnly": "bun test && bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "memory",
    "agent-memory",
    "llm-context",
    "mcp-server",
    "context-compression",
    "token-optimization",
    "claude-code",
    "cursor",
    "codex",
    "local-first",
    "governance",
    "vector-search",
    "sqlite-vec"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/justonemorenight/trimemh"
  },
  "homepage": "https://github.com/justonemorenight/trimemh#readme",
  "author": "Just One More Night",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.165",
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.197",
    "commander": "^15.0.0",
    "hono": "^4.12.23",
    "sqlite-vec": "^0.1.9",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  }
}
